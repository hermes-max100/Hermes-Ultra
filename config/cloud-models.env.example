# Copy this file to .env.cloud-models.local and fill in only the keys you use.
# Keep .env.cloud-models.local private. It is excluded from exports.

export OPENAI_API_KEY=""
export GEMINI_API_KEY=""
export GOOGLE_API_KEY=""
export PERPLEXITY_API_KEY=""
export VENICE_API_KEY=""
export OPENROUTER_API_KEY=""
export ZENMUX_API_KEY=""
export NVIDIA_API_KEY=""
export ADVERSERIAL_API_KEY=""
export OMNIROUTE_API_KEY=""
export NINEROUTER_API_KEY=""

# OpenAI-compatible endpoints.
export ONITH_BASE_URL="http://127.0.0.1:11434/v1"
export OPENAI_BASE_URL="https://api.openai.com/v1"
export GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
export PERPLEXITY_BASE_URL="https://api.perplexity.ai"
export OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
export VENICE_BASE_URL="https://api.venice.ai/api/v1"

# ZenMux is OpenAI-compatible.
export ZENMUX_BASE_URL="https://zenmux.ai/api/v1/"

# NVIDIA NIM is OpenAI-compatible.
export NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# Adverserial CyberKimi is OpenAI-compatible and should be used only through
# the cyberkimi-quarantine profile/policy. Do not make it the default model.
export ADVERSERIAL_BASE_URL="https://api.adverserial.ai/v1"

# OmniRoute is an optional local/self-hosted OpenAI-compatible gateway.
# If your local OmniRoute does not require auth, use a local placeholder value
# for OMNIROUTE_API_KEY so Hermes can intentionally select it.
export OMNIROUTE_BASE_URL="http://127.0.0.1:20128/v1"

# 9Router is an optional local/self-hosted OpenAI-compatible gateway.
# Hermes defaults 9Router to port 20127 to avoid colliding with OmniRoute's
# common 20128 default. If you run 9Router on 20128, override this value.
export NINEROUTER_BASE_URL="http://127.0.0.1:20127/v1"
