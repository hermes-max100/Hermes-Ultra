# Copy this file to ~/.config/hermes/runtime.env and keep the copy private.

# Email transport
export HERMES_SMTP_HOST=""
export HERMES_SMTP_PORT="587"
export HERMES_SMTP_USER=""
export HERMES_SMTP_PASSWORD=""
export HERMES_SMTP_FROM=""

# Contact-form identity
export HERMES_CONTACT_NAME=""
export HERMES_CONTACT_EMAIL=""

# Optional AnyClaw/provider routing
export HERMES_PRIMARY_PROVIDER=""
export HERMES_FALLBACK_PROVIDER=""
