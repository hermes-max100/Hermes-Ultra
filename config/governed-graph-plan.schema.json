{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/governed-graph-plan.schema.json",
  "title": "Hermes Governed Graph Plan",
  "type": "object",
  "required": ["version", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "metadata": {"type": "object"},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]+$"},
    "node": {
      "type": "object",
      "required": ["id", "handler"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "handler": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "input_schema": {"type": "object"},
        "output_schema": {"type": "object"},
        "security_classification": {"enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "LEGAL_PRIVILEGED", "FINANCIAL", "CREDENTIAL", "SECURITY_SENSITIVE"]},
        "estimated_latency_ms": {"type": "number", "minimum": 0},
        "estimated_cost": {"type": "number", "minimum": 0},
        "estimated_tokens": {"type": "integer", "minimum": 0},
        "require_evidence": {"type": "boolean"},
        "max_retries": {"type": "integer", "minimum": 0},
        "metadata": {"type": "object"}
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "source", "target", "kind", "required"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "source": {"$ref": "#/$defs/identifier"},
        "target": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["data", "authority", "order"]},
        "bindings": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^\\$"}},
        "required": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "authority"}}, "required": ["kind"]},
          "then": {"properties": {"required": {"const": true}}}
        }
      ]
    }
  }
}
