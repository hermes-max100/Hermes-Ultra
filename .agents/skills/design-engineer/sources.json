{
  "schema_version": 1,
  "policy": {
    "default_external_trust": "untrusted",
    "promotion_requires": [
      "exact_source_identity",
      "immutable_revision_or_package_version",
      "license_review",
      "dependency_review",
      "instruction_review",
      "behavior_or_sandbox_evaluation",
      "explicit_governance_decision"
    ],
    "self_promotion_allowed": false,
    "scout_execution_allowed": false,
    "baseline_auto_accept_allowed": false
  },
  "sources": [
    {
      "id": "vercel-web-interface-guidelines",
      "name": "Vercel Web Interface Guidelines",
      "trust_class": "trusted_core",
      "authority": "audit",
      "repository": "https://github.com/vercel-labs/web-interface-guidelines",
      "live_rules": "https://raw.githubusercontent.com/vercel-labs/web-interface-guidelines/main/command.md",
      "update_strategy": "fetch-current-rules-at-audit-time",
      "allowed_actions": [
        "read_rules",
        "audit_changed_ui",
        "report_findings"
      ],
      "forbidden_actions": [
        "silently_change_product_requirements",
        "treat_stale_local_copy_as_current"
      ]
    },
    {
      "id": "microsoft-playwright",
      "name": "Microsoft Playwright",
      "trust_class": "trusted_core",
      "authority": "browser_verification",
      "repository": "https://github.com/microsoft/playwright",
      "mcp_repository": "https://github.com/microsoft/playwright-mcp",
      "interface_policy": {
        "deterministic_coding_loop": "prefer_project_native_tests_or_playwright_cli_skills",
        "persistent_exploratory_session": "prefer_playwright_mcp_or_existing_hermes_browser_harness",
        "authenticated_session": "user_authorized_session_only"
      },
      "allowed_actions": [
        "render",
        "inspect",
        "interact",
        "screenshot",
        "test",
        "collect_console_and_network_evidence"
      ],
      "forbidden_actions": [
        "extract_session_credentials_for_reuse",
        "bypass_project_authorization"
      ]
    },
    {
      "id": "senlin-taste",
      "name": "Taste Skill",
      "trust_class": "candidate",
      "authority": "reference_analysis",
      "repository": "https://github.com/senlindesign/taste-skill",
      "activation": "disabled_until_promoted",
      "allowed_actions": [
        "inspect_source",
        "evaluate_in_isolation",
        "reuse_general_measurement_method_with_trusted_browser_primitives"
      ],
      "forbidden_actions": [
        "auto_install",
        "auto_execute",
        "self_promote"
      ],
      "promotion_note": "Record an immutable revision, verify license/dependencies/instructions, and evaluate behavior before activation."
    },
    {
      "id": "awesome-design-catalog",
      "name": "Awesome Design Skills catalog",
      "trust_class": "scout_only",
      "authority": "discovery",
      "repository": "https://github.com/rikre/design-skills",
      "allowed_actions": [
        "list_candidates",
        "inspect_candidate_metadata",
        "propose_design_systems"
      ],
      "forbidden_actions": [
        "auto_install",
        "execute_candidate_code",
        "promote_candidate",
        "treat_catalog_metadata_as_provenance"
      ]
    },
    {
      "id": "abi-screenshot-to-code",
      "name": "Screenshot to Code",
      "trust_class": "optional_adapter",
      "authority": "scaffolding_only",
      "repository": "https://github.com/abi/screenshot-to-code",
      "activation": "disabled_until_needed_and_reviewed",
      "allowed_actions": [
        "generate_initial_scaffold_from_authorized_reference",
        "compare_candidate_implementations"
      ],
      "forbidden_actions": [
        "declare_fidelity_pass",
        "declare_accessibility_pass",
        "declare_security_pass",
        "copy_unauthorized_identity_assets"
      ]
    },
    {
      "id": "hermes-browser-harness-self-healing",
      "name": "Hermes browser-harness-self-healing skill",
      "trust_class": "local_existing",
      "authority": "browser_transport",
      "path": "../browser-harness-self-healing/SKILL.md",
      "interface_policy": "reuse_when_already_configured_for_the_project",
      "allowed_actions": [
        "render",
        "inspect",
        "interact",
        "screenshot"
      ]
    }
  ]
}
