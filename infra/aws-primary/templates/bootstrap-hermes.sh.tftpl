#!/usr/bin/env bash
set -euo pipefail
exec > >(tee -a /var/log/hermes-bootstrap.log | logger -t hermes-bootstrap -s 2>/dev/console) 2>&1

export DEBIAN_FRONTEND=noninteractive
AWS_REGION='${aws_region}'
ARTIFACT_BUCKET='${artifact_bucket}'
RELEASE_OBJECT_KEY='${release_object_key}'
RELEASE_SHA256='${release_sha256}'
RUNTIME_SECRET_PREFIX='${runtime_ssm_parameter_prefix}'
STAGING='/var/tmp/hermes-release.tar.gz'
CANDIDATE='/var/tmp/hermes-release-candidate'

apt-get update
apt-get install -y --no-install-recommends \
  awscli bash ca-certificates coreutils curl findutils git gzip jq nodejs npm python3 python3-pip \
  python3-venv ripgrep tar tmux unzip

if ! id hermes >/dev/null 2>&1; then
  useradd --system --create-home --home-dir /var/lib/hermes --shell /bin/bash hermes
fi
install -d -o hermes -g hermes -m 0750 /var/lib/hermes/.config/hermes

# Relay and the mobile client remain private on the user's tailnet.
install -d -m 0755 /usr/share/keyrings
curl --fail --location --proto '=https' --tlsv1.2 \
  https://pkgs.tailscale.com/stable/ubuntu/noble.noarmor.gpg \
  -o /usr/share/keyrings/tailscale-archive-keyring.gpg
curl --fail --location --proto '=https' --tlsv1.2 \
  https://pkgs.tailscale.com/stable/ubuntu/noble.tailscale-keyring.list \
  -o /etc/apt/sources.list.d/tailscale.list
apt-get update
apt-get install -y --no-install-recommends tailscale
systemctl enable --now tailscaled.service

aws s3 cp --region "$AWS_REGION" "s3://$ARTIFACT_BUCKET/$RELEASE_OBJECT_KEY" "$STAGING"
echo "$RELEASE_SHA256  $STAGING" | sha256sum -c -

# Execute no release code until both the outer archive and internal manifest pass.
rm -rf "$CANDIDATE"
mkdir -p "$CANDIDATE"
tar -xzf "$STAGING" -C "$CANDIDATE"
ROOT_COUNT="$(find "$CANDIDATE" -mindepth 1 -maxdepth 1 | wc -l)"
if [[ "$ROOT_COUNT" == 1 ]]; then
  INNER="$(find "$CANDIDATE" -mindepth 1 -maxdepth 1 -type d -print -quit)"
  if [[ -n "$INNER" ]]; then
    shopt -s dotglob
    mv "$INNER"/* "$CANDIDATE"/
    shopt -u dotglob
    rmdir "$INNER"
  fi
fi
[[ -f "$CANDIDATE/CLOUD_RELEASE_MANIFEST.sha256" ]] || { echo 'internal release manifest missing' >&2; exit 1; }
( cd "$CANDIDATE" && sha256sum -c CLOUD_RELEASE_MANIFEST.sha256 >/dev/null )
chmod +x "$CANDIDATE"/scripts/*.sh "$CANDIDATE"/src/system/*.sh

# Secrets arrive after verification and never enter Terraform state or the artifact.
runuser -u hermes -- env \
  AWS_REGION="$AWS_REGION" \
  HERMES_RUNTIME_SECRET_PREFIX="$RUNTIME_SECRET_PREFIX" \
  HERMES_RUNTIME_ENV_PATH=/var/lib/hermes/.config/hermes/runtime.env \
  "$CANDIDATE/src/system/load-aws-runtime-secrets.sh"
TAILSCALE_AUTH_KEY="$(python3 - /var/lib/hermes/.config/hermes/runtime.env <<'PY'
import pathlib, shlex, sys
for line in pathlib.Path(sys.argv[1]).read_text().splitlines():
    if line.startswith('TAILSCALE_AUTH_KEY='):
        values = shlex.split(line.split('=', 1)[1])
        if len(values) == 1:
            print(values[0])
        break
PY
)"
[[ -n "$TAILSCALE_AUTH_KEY" ]] || { echo 'TAILSCALE_AUTH_KEY missing from SSM runtime parameters' >&2; exit 1; }
tailscale up --auth-key="$TAILSCALE_AUTH_KEY" --hostname=hermes-max \
  --accept-dns=true --advertise-tags=tag:hermes-prod --ssh
unset TAILSCALE_AUTH_KEY
python3 - /var/lib/hermes/.config/hermes/runtime.env <<'PY'
import pathlib, sys
p = pathlib.Path(sys.argv[1])
rows = [line for line in p.read_text().splitlines() if not line.startswith('TAILSCALE_AUTH_KEY=')]
p.write_text(('\n'.join(rows) + '\n') if rows else '')
PY
chmod 0600 /var/lib/hermes/.config/hermes/runtime.env
TAILSCALE_IP="$(tailscale ip -4 | head -n1)"
[[ -n "$TAILSCALE_IP" ]] || { echo 'Tailscale did not assign an IPv4 address' >&2; exit 1; }

ORCA_PAIRING_ADDRESS="$TAILSCALE_IP" bash "$CANDIDATE/scripts/install-orca-runtime.sh"
HERMES_ORCA_DISABLE=1 bash "$CANDIDATE/scripts/install-cloud-release-local.sh" "$STAGING" "$RELEASE_SHA256"

systemctl is-active --quiet hermes-runtime.service
systemctl is-active --quiet hermes-relay.service
systemctl is-active --quiet orca-serve.service
runuser -u hermes -- /opt/hermes-max/current/scripts/hermes-relay-doctor.sh

rm -rf "$CANDIDATE" "$STAGING"
echo "HERMES_BOOTSTRAP=PASS release=$${RELEASE_SHA256:0:16}"
