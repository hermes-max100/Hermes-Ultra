NAME="bash-script-hardener"
VERSION="0.1.0"
DESCRIPTION="Reviews bash scripts for security defects, quoting errors, unquoted variables, missing set options, race conditions, and injection vectors."
TAGS="bash shell script security hardening quoting set-options injection race condition"
TRIGGERS="bash shell script harden security audit quoting set -euo pipefail variable injection"
INPUTS="bash-script sh-script"
OUTPUTS="security-report hardened-script diff-patch issue-list best-practice-checklist"
RISK_LEVEL="medium"
