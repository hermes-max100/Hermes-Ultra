NAME="citation-integrity-checker"
VERSION="0.1.0"
DESCRIPTION="Verifies that every citation in a legal document traces to a real source, checks page numbers, pinpoint cites, and quotation accuracy."
TAGS="citation integrity verification legal authority pinpoint page quote source check record"
TRIGGERS="citation pinpoint page quote source verify authority record page-number shepardize keycite"
INPUTS="pdf brief motion memo declaration legal-document"
OUTPUTS="citation-audit-table verified-citations unverified-citations misquoted-text pinpoint-errors source-index"
RISK_LEVEL="high"
