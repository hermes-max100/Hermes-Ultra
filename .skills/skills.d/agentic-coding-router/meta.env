NAME="agentic-coding-router"
VERSION="0.1.0"
DESCRIPTION="Routes coding tasks to the right execution pattern: script generation, repo analysis, build automation, test creation, or full agentic build."
TAGS="code script build test repo automation agent development programming"
TRIGGERS="code script build test repo npm pip git deploy automation function app refactor failing"
INPUTS="description codebase spec requirements"
OUTPUTS="execution-plan code-diff test-results build-log deployment-status"
RISK_LEVEL="medium"
