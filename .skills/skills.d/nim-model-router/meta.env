NAME="nim-model-router"
VERSION="0.1.0"
DESCRIPTION="Routes requests to the optimal NIM-hosted model based on task type, latency requirements, context length, and cost constraints."
TAGS="nim model routing llm inference latency cost context selection nvidia"
TRIGGERS="nim model route inference latency cost context-length select-model llm api nvidia"
INPUTS="task-description latency-budget context-size model-list"
OUTPUTS="model-selection routing-table cost-estimate latency-estimate"
RISK_LEVEL="low"
